        public bool IsReviewer { get; set; } = false;
    }

    private class WorldEntryForm
    {
        public string Title { get; set; } = "";
        public string Content { get; set; } = "";
        public string Category { get; set; } = "其他";
        public string Keywords { get; set; } = "";
    }
